summary: Kdump NFS dumping tests with FIPS enabled

provision:
   - name: client
   - name: server

discover+:
    test:
     - /kdump/config-restraint
     - /security/crypto/enable_fips
     - /kdump/config-default-crashkernel
     - /kdump/config-nfs
     - /kdump/crash-sysrq-c
     - /kdump/copy-nfs
     - /kdump/analyse-crash-cmd/simple_check
